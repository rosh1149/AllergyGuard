# Copy to .env and fill in.
ENVIRONMENT=development

# Used when running the backend outside Docker (docker-compose overrides it).
DATABASE_URL=postgresql+psycopg://allergyguard:allergyguard@localhost:5432/allergyguard

# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Creates a demo restaurant + demo accounts (password Demo1234!). Set false in production.
SEED_DEMO_DATA=true

# AI features. Leave the key empty to run with non-AI fallbacks (template explanations, etc.).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty.
LLM_MODEL=

# Packaged-food pipeline
OFF_BASE_URL=https://world.openfoodfacts.org
MAX_UPLOAD_MB=10
# Path to the tesseract binary if it is not on PATH.
TESSERACT_CMD=
